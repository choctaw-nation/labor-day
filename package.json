{
	"name": "cno-labor-day",
	"version": "2.1.6",
	"description": "Custom WP theme for CNO labor day site",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"start": "wp-scripts start --blocks-manifest  --webpack-copy-php --source-path=wp-content/themes/labor-day/src/ --output-path=wp-content/themes/labor-day/dist/",
		"build": "wp-scripts build --blocks-manifest  --webpack-copy-php --source-path=wp-content/themes/labor-day/src/ --output-path=wp-content/themes/labor-day/dist/",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update"
	},
	"author": "Choctaw Nation of Oklahoma",
	"license": "GPL-3.0-or-later",
	"dependencies": {
		"@choctawnationofoklahoma/wp-flex-reverse-toggle": "^1.1.1",
		"aos": "^2.3.4",
		"bootstrap": "^5.3.7",
		"date-fns": "^4.1.0",
		"swiper": "^11.2.10"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.2",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.34.0",
		"@types/react": "^19.1.12",
		"@types/wordpress__blocks": "^12.5.18",
		"@wordpress/block-editor": "^15.2.0",
		"@wordpress/components": "^30.2.0",
		"@wordpress/editor": "^14.29.0",
		"@wordpress/scripts": "^30.22.0",
		"animate.css": "^4.1.1",
		"eslint": "^9.34.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.3.0",
		"react": "^18.3.1",
		"stylelint": "^16.23.1",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-scss": "^6.12.1",
		"webpack-remove-empty-scripts": "^1.1.1",
		"wp-types": "^4.68.1"
	}
}
