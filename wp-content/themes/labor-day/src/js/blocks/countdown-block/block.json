{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cno/countdown-block",
	"version": "0.1.0",
	"title": "Countdown",
	"category": "widgets",
	"icon": "clock",
	"keywords": [ "countdown", "timer" ],
	"description": "Display a countdown to a specific date and time with customizable styling and labels.",
	"example": {
		"attributes": {
			"targetDate": "2025-12-31T23:59:59",
			"showDays": true,
			"showHours": true,
			"showMinutes": true,
			"showSeconds": true
		}
	},
	"attributes": {
		"targetDate": {
			"type": "string",
			"default": ""
		},
		"showDays": {
			"type": "boolean",
			"default": true
		},
		"showHours": {
			"type": "boolean",
			"default": true
		},
		"showMinutes": {
			"type": "boolean",
			"default": true
		},
		"showSeconds": {
			"type": "boolean",
			"default": true
		},
		"labelDays": {
			"type": "string",
			"default": "Days"
		},
		"labelHours": {
			"type": "string",
			"default": "Hours"
		},
		"labelMinutes": {
			"type": "string",
			"default": "Minutes"
		},
		"labelSeconds": {
			"type": "string",
			"default": "Seconds"
		},
		"completionMessage": {
			"type": "string",
			"default": "The countdown has ended!"
		},
		"numberColor": {
			"type": "string",
			"default": "#000000"
		},
		"labelColor": {
			"type": "string",
			"default": "#666666"
		},
		"numberFontSize": {
			"type": "string",
			"default": "1.2rem"
		},
		"labelFontSize": {
			"type": "string",
			"default": "16px"
		},
		"textAlign": {
			"type": "string",
			"default": "center",
			"enum": [ "left", "center", "right" ]
		},
		"alignment": {
			"type": "string",
			"default": "center",
			"enum": [
				"flex-start",
				"center",
				"flex-end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"orientation": {
			"type": "string",
			"default": "horizontal",
			"enum": [ "horizontal", "vertical" ]
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"alignWide": true,
		"color": {
			"text": false,
			"background": false,
			"gradients": false,
			"link": false
		},
		"spacing": {
			"padding": false,
			"margin": true,
			"blockGap": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}
